{
  "id": "agent-problem-solving",
  "name": "Agent Problem Solving",
  "description": "One plugin bundling the method skills, a per-turn hook and the aps command: one named problem per chat thread, the register and a context gauge in front of the agent on every turn, every change in an append-only decision log.",
  "version": "0.3.1",
  "activation": {
    "onStartup": true
  },
  "skills": [
    "skills"
  ],
  "configSchema": {
    "type": "object",
    "additionalProperties": false,
    "required": [
      "overlayPath"
    ],
    "properties": {
      "enabled": {
        "type": "boolean"
      },
      "agents": {
        "type": "array",
        "items": {
          "type": "string"
        }
      },
      "overlayPath": {
        "type": "string",
        "minLength": 1,
        "pattern": "^/"
      },
      "registerFile": {
        "type": "string"
      },
      "warnTokens": {
        "type": "integer",
        "minimum": 1000
      },
      "highTokens": {
        "type": "integer",
        "minimum": 1000
      },
      "canCompact": {
        "type": "boolean"
      },
      "timeZone": {
        "type": "string"
      }
    }
  }
}
