{
  "name": "agent-problem-solving",
  "version": "0.2.0",
  "private": false,
  "type": "module",
  "description": "Keep a chat agent on one named problem per thread, re-injected every turn, with an append-only decision log.",
  "scripts": {
    "test": "node --test \"test/*.test.js\"",
    "denylist": "node bin/denylist-check.mjs"
  },
  "openclaw": {
    "extensions": [
      "./index.js"
    ],
    "compat": {
      "pluginApi": ">=2026.7.1",
      "minGatewayVersion": "2026.7.1"
    }
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Rendiere/agent-problem-solving.git"
  },
  "bin": {
    "aps": "./bin/aps.mjs"
  },
  "files": [
    "index.js",
    "lib",
    "bin",
    "skills",
    "templates",
    "scorer",
    "replay",
    "hooks",
    "openclaw.plugin.json",
    "README.md",
    "LICENSE"
  ]
}