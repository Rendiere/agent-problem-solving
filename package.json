{
  "name": "agent-problem-solving",
  "version": "0.3.0",
  "type": "module",
  "description": "One plugin bundling the method skills, a per-turn hook and the aps command, to keep each chat thread on one named problem.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Rendiere/agent-problem-solving.git"
  },
  "bin": {
    "aps": "./bin/aps.mjs"
  },
  "scripts": {
    "test": "node --test test/*.test.js",
    "denylist": "node tools/denylist-check.mjs"
  },
  "files": [
    ".agents",
    ".claude-plugin",
    "LICENSE",
    "README.md",
    "adapters",
    "bin",
    "hooks",
    "lib",
    "openclaw.plugin.json",
    "plugin.json",
    "replay",
    "scorer",
    "skills",
    "templates",
    "tools"
  ],
  "openclaw": {
    "extensions": [
      "./adapters/openclaw/index.js"
    ],
    "compat": {
      "pluginApi": ">=2026.7.1",
      "minGatewayVersion": "2026.7.1"
    }
  },
  "engines": {
    "node": ">=18"
  }
}
