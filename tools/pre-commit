#!/bin/sh
# Refuse a commit that puts an overlay identifier in the core.
#
# Install it in the operator's working copy of the core:
#   git config core.hooksPath tools
# It needs APS_OVERLAY to point at the overlay holding denylist.txt. Without
# that it refuses rather than passing quietly, because a silent pass here is the
# failure it exists to stop.

set -e
root=$(git rev-parse --show-toplevel)
if [ -z "$APS_OVERLAY" ] && [ -f "$root/.aps-overlay" ]; then
  APS_OVERLAY=$(cat "$root/.aps-overlay")
  export APS_OVERLAY
fi
if [ -z "$APS_OVERLAY" ]; then
  echo "pre-commit: APS_OVERLAY is not set, so the deny-list cannot be checked." >&2
  echo "            Set it, or write the overlay path into $root/.aps-overlay." >&2
  exit 1
fi
exec node "$root/tools/denylist-check.mjs" --staged
