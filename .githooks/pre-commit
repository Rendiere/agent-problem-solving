#!/usr/bin/env python3
"""Block a commit that stages a file over 5,000 tokens, where a token is 4 bytes.

Only staged files are measured, and each is measured on the blob that is about
to be committed rather than the working copy. Files nobody wrote by hand --
lockfiles, build output, generated code, binaries -- are skipped, and a repo can
exempt anything else through .token-limit-ignore.

Whatever pre-commit hook this one displaced still runs, first.
"""
import math
import os
import re
import subprocess
import sys

TOKEN_LIMIT = 5000
BYTES_PER_TOKEN = 4
BYTE_LIMIT = TOKEN_LIMIT * BYTES_PER_TOKEN
SPLIT_TARGET = int(TOKEN_LIMIT * 0.8)
CHAIN_GUARD = "TOKEN_LIMIT_HOOK_RUNNING"
VERBOSE = os.environ.get("TOKEN_LIMIT_HOOK_VERBOSE") == "1"

LOCKFILES = {
    "package-lock.json", "yarn.lock", "pnpm-lock.yaml", "npm-shrinkwrap.json",
    "bun.lock", "bun.lockb", "Cargo.lock", "poetry.lock", "uv.lock",
    "Pipfile.lock", "Gemfile.lock", "composer.lock", "go.sum", "flake.lock",
    "pubspec.lock", "packages.lock.json", "mix.lock", "deno.lock",
    "Package.resolved", "gradle.lockfile",
}
BUILD_DIRS = {
    "dist", "build", ".next", "out", "coverage", "node_modules", "vendor",
    "__pycache__", ".venv", ".svelte-kit", ".turbo", ".output", ".beads",
}
BUILD_GLOBS = (
    "*.min.js", "*.min.mjs", "*.min.css", "*.js.map", "*.mjs.map", "*.css.map",
    "*_pb2.py", "*_pb2_grpc.py", "*.pb.go", "*.g.dart", "*.freezed.dart",
    "*.gen.go", "*.gen.ts", "*.generated.ts", "*.generated.js", "*.log", "*.bak",
)
# Formats no one types out, whether or not a NUL lands in the first 8 KB.
BINARY_GLOBS = (
    "*.pdf", "*.png", "*.jpg", "*.jpeg", "*.gif", "*.webp", "*.ico", "*.bmp",
    "*.tiff", "*.heic", "*.mp3", "*.wav", "*.m4a", "*.ogg", "*.mp4", "*.mov",
    "*.webm", "*.zip", "*.tar", "*.gz", "*.tgz", "*.bz2", "*.xz", "*.7z",
    "*.woff", "*.woff2", "*.ttf", "*.otf", "*.eot", "*.psd", "*.sketch",
    "*.xlsx", "*.xls", "*.docx", "*.doc", "*.pptx", "*.ppt", "*.parquet",
    "*.sqlite", "*.db", "*.dxf", "*.stl", "*.glb", "*.wasm", "*.so", "*.dylib",
)
# ORM snapshot directories: the migration SQL is reviewable, the snapshot is not.
SNAPSHOT_PARENTS = (("drizzle", "meta"), ("migrations", "meta"), ("prisma", "meta"))
GENERATED_MARKERS = ("@generated", "DO NOT EDIT", "Code generated")


def git(*args, binary=False):
    """Run git and return stdout, or None if it failed."""
    argv = ["git"]
    for arg in args:
        argv.append(arg if isinstance(arg, bytes) else str(arg))
    done = subprocess.run(argv, stdout=subprocess.PIPE, stderr=subprocess.DEVNULL)
    if done.returncode != 0:
        return None
    return done.stdout if binary else done.stdout.decode("utf-8", "surrogateescape")


def warn(message):
    sys.stderr.write("token-limit hook: %s\n" % message)


def chain_displaced_hooks():
    """Run every pre-commit hook this one stands in front of. Stop if one fails."""
    if os.environ.get(CHAIN_GUARD) == "1":
        return
    candidates = []
    configured = git("config", "--get", "tokenlimit.chain") or ""
    candidates.append(configured.strip())
    common = (git("rev-parse", "--git-common-dir") or ".git").strip()
    candidates.append(os.path.join(common, "hooks", "pre-commit"))
    # Hook directories other tools own, so this hook travels without extra config.
    for known in (".husky", ".beads/hooks", "scripts/hooks", ".config/hooks"):
        candidates.append(os.path.join(known, "pre-commit"))
    me = os.path.realpath(__file__)
    seen = {me}
    env = dict(os.environ, **{CHAIN_GUARD: "1"})
    for candidate in candidates:
        if not candidate:
            continue
        path = os.path.realpath(candidate)
        if path in seen:
            continue
        seen.add(path)
        if not os.path.isfile(path) or not os.access(path, os.X_OK):
            continue
        try:
            done = subprocess.run([path, *sys.argv[1:]], env=env)
        except OSError as problem:
            warn("could not run the hook at %s (%s); carrying on" % (candidate, problem))
            continue
        if done.returncode != 0:
            sys.exit(done.returncode)


def pattern_to_regex(pattern):
    """Translate one gitignore-style line into a regex over a repo-relative path."""
    anchored = pattern.startswith("/")
    pattern = pattern.lstrip("/")
    dir_only = pattern.endswith("/")
    pattern = pattern.rstrip("/")
    anchored = anchored or "/" in pattern
    out = []
    index = 0
    while index < len(pattern):
        char = pattern[index]
        if pattern.startswith("**/", index):
            out.append("(?:.*/)?")
            index += 3
        elif pattern.startswith("/**", index):
            out.append("/.*")
            index += 3
        elif pattern.startswith("**", index):
            out.append(".*")
            index += 2
        elif char == "*":
            out.append("[^/]*")
            index += 1
        elif char == "?":
            out.append("[^/]")
            index += 1
        elif char == "[":
            close = pattern.find("]", index)
            if close == -1:
                out.append(re.escape(char))
                index += 1
            else:
                out.append(pattern[index:close + 1])
                index = close + 1
        else:
            out.append(re.escape(char))
            index += 1
    body = "".join(out)
    head = "" if anchored else "(?:.*/)?"
    tail = "/.*" if dir_only else "(?:/.*)?"
    return re.compile("^" + head + body + tail + "$")


def load_ignore_rules():
    """Read .token-limit-ignore, staged copy first, as (regex, negated) pairs."""
    raw = git("show", ":.token-limit-ignore")
    if raw is None:
        try:
            with open(".token-limit-ignore", encoding="utf-8", errors="surrogateescape") as f:
                raw = f.read()
        except OSError:
            return []
    rules = []
    for line in raw.splitlines():
        line = line.strip()
        if not line or line.startswith("#"):
            continue
        negated = line.startswith("!")
        if negated:
            line = line[1:].strip()
        if line:
            rules.append((pattern_to_regex(line), negated))
    return rules


def is_ignored(path, rules):
    decided = False
    for regex, negated in rules:
        if regex.match(path):
            decided = not negated
    return decided


def is_not_hand_written(path, blob):
    name = os.path.basename(path)
    parts = path.split("/")
    if name in LOCKFILES:
        return True
    if any(part in BUILD_DIRS for part in parts[:-1]):
        return True
    for glob in BUILD_GLOBS + BINARY_GLOBS:
        if pattern_to_regex(glob).match(name):
            return True
    for tail in SNAPSHOT_PARENTS:
        if len(parts) > len(tail) and tuple(parts[-len(tail) - 1:-1]) == tail:
            return True
    head = blob[:8192]
    if b"\0" in head:
        return True
    opening = head.decode("utf-8", "replace").splitlines()[:5]
    if any(marker in "\n".join(opening) for marker in GENERATED_MARKERS):
        return True
    return False


def staged_paths():
    out = git("diff", "--cached", "--name-only", "--diff-filter=ACMRT", "-z")
    if out is None:
        return []
    return [p for p in out.split("\0") if p]


def staged_sizes(paths):
    """One `git cat-file --batch-check` for every staged path."""
    if not paths:
        return {}
    stdin = b"".join(b":" + p.encode("utf-8", "surrogateescape") + b"\n" for p in paths)
    done = subprocess.run(
        ["git", "cat-file", "--batch-check"],
        input=stdin, stdout=subprocess.PIPE, stderr=subprocess.DEVNULL,
    )
    sizes = {}
    lines = done.stdout.decode("utf-8", "surrogateescape").splitlines()
    for path, line in zip(paths, lines):
        fields = line.rsplit(" ", 2)
        if len(fields) == 3 and fields[1] == "blob" and fields[2].isdigit():
            sizes[path] = int(fields[2])
        else:
            warn("could not measure %s; letting it through" % path)
    return sizes


def report(offenders):
    width = max(len(path) for path, _ in offenders)
    lines = [
        "",
        "  Commit blocked. These staged files are over the %s token limit" % f"{TOKEN_LIMIT:,}",
        "  (a token is counted as %d bytes):" % BYTES_PER_TOKEN,
        "",
    ]
    for path, tokens in offenders:
        lines.append("    %-*s  %s tokens" % (width, path, f"{tokens:,}"))
    lines += [
        "",
        "  Split each one by responsibility, so that every file you end up with",
        "  is under about %s tokens. How to split, by kind of file:" % f"{SPLIT_TARGET:,}",
        "",
        "    code:     move each cohesive group of functions or classes into its",
        "              own file, then import or re-export them from the original.",
        "              Leave the original as a thin entry point so that callers",
        "              do not have to change.",
        "    tests:    one test file per unit under test. Shared setup goes in a",
        "              helper or fixture file that the test files import.",
        "    markdown: split at the top-level headings into a folder with one",
        "              file per section, and leave an index file linking to them.",
        "    JSON and other data: split by top-level key, one file per key. If",
        "              nobody wrote the data by hand, list it in",
        "              .token-limit-ignore instead of splitting it.",
        "",
        "  Some files above may not have been written by hand at all: a lockfile,",
        "  build output, generated code, a recorded transcript, third-party data.",
        "  Add those to .token-limit-ignore in this repo instead of splitting them.",
        "",
        "  To get past this in an emergency, and only then:",
        "    git commit --no-verify",
        "",
    ]
    sys.stderr.write("\n".join(lines))


def main():
    chain_displaced_hooks()
    if os.path.exists(os.path.join((git("rev-parse", "--git-dir") or ".git").strip(), "MERGE_HEAD")):
        if VERBOSE:
            warn("merge in progress, skipping the size check")
        return 0
    rules = load_ignore_rules()
    paths = [p for p in staged_paths() if not is_ignored(p, rules)]
    offenders = []
    for path, size in staged_sizes(paths).items():
        if size <= BYTE_LIMIT:
            continue
        blob = git("cat-file", "blob", ":" + path, binary=True)
        if blob is None or is_not_hand_written(path, blob):
            continue
        offenders.append((path, math.ceil(size / BYTES_PER_TOKEN)))
    if VERBOSE:
        warn("checked %d staged file(s)" % len(paths))
    if offenders:
        report(sorted(offenders))
        return 1
    return 0


if __name__ == "__main__":
    try:
        sys.exit(main())
    except SystemExit:
        raise
    except Exception as problem:  # never block a commit on a bug in here
        warn("skipped the size check after an internal error: %r" % problem)
        sys.exit(0)
